{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-before-commit.sh",
            "timeout": 300,
            "statusMessage": "Running the gate before commit…"
          }
        ]
      }
    ]
  }
}
