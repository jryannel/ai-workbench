{
  "description": "Refuse a commit while the project's fast gate is red. No-ops in repos where no gate is detected.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/verify-before-commit.sh",
            "timeout": 300,
            "statusMessage": "Running the gate before commit…"
          }
        ]
      }
    ]
  }
}
